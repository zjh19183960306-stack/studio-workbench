def has_audio(path):
    r = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'a:0',
                        '-show_entries', 'stream=codec_type', '-of', 'csv=p=0', str(path)],
                       capture_output=True, text=True, timeout=120)
    return r.returncode == 0 and 'audio' in (r.stdout or '')

def probe_duration(path):
    r = subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
                        '-of', 'json', str(path)], capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        raise RuntimeError('E_H3_PROBE')
    return float(json.loads(r.stdout)['format']['duration'])

def trim_to_duration(src, dest, dur_sec):
    """Cut video to exactly dur_sec (H3 min pad / segment slide may overshoot source)."""
    src, dest = Path(src), Path(dest)
    dur_sec = max(0.1, float(dur_sec))
    if dest.exists():
        dest.unlink()
    cmd = ["ffmpeg", "-y", "-i", str(src), "-t", "%.6f" % dur_sec,
           "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
           "-c:a", "aac", "-b:a", "192k", "-movflags", "+faststart", str(dest)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    if r.returncode != 0 or not dest.is_file() or dest.stat().st_size < 1000:
        # retry video-only
        cmd = ["ffmpeg", "-y", "-i", str(src), "-t", "%.6f" % dur_sec, "-an",
               "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
               "-movflags", "+faststart", str(dest)]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if r.returncode != 0 or not dest.is_file() or dest.stat().st_size < 1000:
            raise RuntimeError("E_H3_TRIM")
    try:
        os.chmod(dest, 0o600)
    except OSError:
        pass
    return dest


def driver_video_path(owner, motion_ids):
    """Resolve original driver RGB video from motion preview video_id. Never use depth/white."""
    if not motion_ids:
        return None
    mid = motion_ids[0]
    if not isinstance(mid, str) or ':' not in mid:
        return None
    jid = mid.split(':', 1)[0]
    try:
        d = m.read_owned(m.QUEUE, jid, owner)
    except ValueError:
        return None
    vid = d.get('video_id')
    if not isinstance(vid, str):
        return None
    c = m.catalog()
    v = c.get(vid)
    if not v or v.get('kind') != 'video':
        return None
    p = Path(v['path'])
    if not p.is_file() or p.is_symlink():
        return None
    return p

def mux_orig_audio(result_mp4, driver_mp4, out_mp4):
    """Keep result video frames; replace audio with driver. Trim/pad to result duration."""
    result_mp4, driver_mp4, out_mp4 = Path(result_mp4), Path(driver_mp4), Path(out_mp4)
    if out_mp4.exists():
        out_mp4.unlink()
    if not has_audio(driver_mp4):
        raise RuntimeError('E_H3_NO_DRIVER_AUDIO')
    dur = probe_duration(result_mp4)
    cmd = ['ffmpeg', '-y', '-i', str(result_mp4), '-i', str(driver_mp4),
           '-map', '0:v:0', '-map', '1:a:0', '-c:v', 'copy', '-af', 'apad',
           '-t', f'{dur:.6f}', '-c:a', 'aac', '-b:a', '192k',
           '-movflags', '+faststart', str(out_mp4)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    if r.returncode != 0 or not out_mp4.is_file() or out_mp4.stat().st_size < 1000:
        raise RuntimeError('E_H3_MUX_FAIL')
    try:
        os.chmod(out_mp4, 0o600)
    except OSError:
        pass
    return out_mp4


def segment_sec():
    try:
        return max(5, min(15, int(os.environ.get('H3_SEGMENT_SEC', '15'))))
    except ValueError:
        return 15

def split_control_video(src, work_dir, seg_sec=None):
    """If duration > seg_sec, cut into <=seg_sec clips with overlap (for xfade). Else [src].

    Official H3 Fun CN only accepts 5–15s on the 17k+5 grid. After min-frame clamp,
    a short leftover tail (<~5.17s) would be last-frame-padded and stretch delivery
    past the source. Absorb that tail by sliding the final window backward so every
    generated segment is >= min_seg, then stitch with the *actual* overlap.
    Writes work_dir/segs_meta.json: [{t0, length}, ...] for concat trim.
    """
    seg_sec = segment_sec() if seg_sec is None else seg_sec
    overlap = float(os.environ.get("H3_SEGMENT_OVERLAP", "1.0"))
    min_seg = float(os.environ.get("H3_MIN_SEG_SEC", "%.6f" % (H3_MIN_FRAMES / float(H3_FPS))))
    src = Path(src)
    dur = probe_duration(src)
    if dur <= seg_sec + 0.05:
        return [src], False, dur
    work_dir = Path(work_dir)
    work_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Plan window starts so each clip length is in [min_seg, seg_sec] and covers [0, dur].
    windows = []  # (t0, length)
    t = 0.0
    step = max(seg_sec - overlap, 1.0)
    guard = 0
    while t < dur - 0.05:
        rem = dur - t
        if rem <= seg_sec + 0.05:
            if rem + 0.05 < min_seg and windows:
                # Slide final window back so it ends at dur and is at least min_seg.
                length = min(seg_sec, max(min_seg, rem))
                t0 = max(0.0, dur - length)
                # Avoid a duplicate near-identical window.
                prev_t0, prev_len = windows[-1]
                if abs(t0 - prev_t0) < 0.05 and abs(length - prev_len) < 0.05:
                    windows[-1] = (t0, dur - t0)
                else:
                    windows.append((t0, dur - t0))
            else:
                windows.append((t, rem))
            break
        windows.append((t, float(seg_sec)))
        t += step
        guard += 1
        if guard > 500:
            raise RuntimeError("E_H3_SEGMENT_SPLIT")
    parts = []
    meta = []
    for i, (t0, length) in enumerate(windows):
        part = work_dir / ("ctl_seg_%03d.mp4" % i)
        cmd = ["ffmpeg", "-y", "-ss", "%.3f" % t0, "-i", str(src), "-t", "%.3f" % length,
               "-an", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
               "-movflags", "+faststart", str(part)]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if r.returncode != 0 or not part.is_file() or part.stat().st_size < 1000:
            raise RuntimeError("E_H3_SEGMENT_SPLIT")
        parts.append(part)
        meta.append({"t0": round(t0, 6), "length": round(length, 6)})
    (work_dir / "segs_meta.json").write_text(json.dumps(meta, ensure_ascii=False), encoding="utf-8")
    return parts, True, dur


def concat_mp4s(parts, out_mp4):
    """Concat segment mp4s; short xfade (0.5s) when >=2 parts, else copy.

    When segs_meta.json shows a seam overlap larger than H3_XFADE_SEC (final window
    slid back for the 5s H3 minimum), skip xfade and hard-concat with that actual
    lead trim so overlapped motion is not replayed.
    """
    out_mp4 = Path(out_mp4)
    parts = [Path(p) for p in parts]
    if len(parts) == 1:
        shutil.copy2(parts[0], out_mp4)
        return out_mp4
    xfade = float(os.environ.get("H3_XFADE_SEC", "0.5"))
    overlap_default = float(os.environ.get("H3_SEGMENT_OVERLAP", "1.0"))
    n = len(parts)
    durs = [probe_duration(p) for p in parts]
    meta_path = None
    for cand in (out_mp4.parent / "segs_meta.json", parts[0].parent / "segs_meta.json"):
        if cand.is_file():
            meta_path = cand
            break
    lead_trims = [0.0] * n
    prefer_hard = False
    if meta_path is not None:
        try:
            meta = json.loads(meta_path.read_text(encoding="utf-8"))
            if isinstance(meta, list) and len(meta) == n:
                for i in range(1, n):
                    prev_end = float(meta[i - 1]["t0"]) + float(meta[i - 1]["length"])
                    cur_t0 = float(meta[i]["t0"])
                    lead_trims[i] = max(0.0, prev_end - cur_t0)
                    if lead_trims[i] > xfade + 0.15:
                        prefer_hard = True
        except (OSError, ValueError, KeyError, TypeError):
            lead_trims = [0.0] + [overlap_default] * (n - 1)
    else:
        lead_trims = [0.0] + [overlap_default] * (n - 1)

    xfade_ok = False
    if not prefer_hard:
        cmd = ["ffmpeg", "-y"]
        for pth in parts:
            cmd += ["-i", str(pth)]
        filters = []
        last = "[0:v]"
        offset = 0.0
        for i in range(1, n):
            offset += max(durs[i - 1] - xfade, 0.01)
            outlab = "[v%x]" % i if i < n - 1 else "[vout]"
            filters.append("%s[%d:v]xfade=transition=fade:duration=%.3f:offset=%.3f%s" % (last, i, xfade, offset, outlab))
            last = outlab
        filt = ";".join(filters)
        cmd += ["-filter_complex", filt, "-map", "[vout]",
                "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
                "-an", "-movflags", "+faststart", str(out_mp4)]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
        xfade_ok = r.returncode == 0 and out_mp4.is_file() and out_mp4.stat().st_size >= 1000
        if xfade_ok:
            try:
                expect = sum(durs) - xfade * (n - 1)
                got = probe_duration(out_mp4)
                bad = (xfade >= min(durs) - 0.01) or expect < 0.5 or got < expect * 0.85 or got > expect * 1.15 + 0.5
                if bad:
                    xfade_ok = False
                    out_mp4.unlink(missing_ok=True)
            except Exception:
                xfade_ok = False
                out_mp4.unlink(missing_ok=True)

    if not xfade_ok:
        work = out_mp4.parent
        trimmed = []
        for i, srcp in enumerate(parts):
            lead = float(lead_trims[i]) if i < len(lead_trims) else overlap_default
            if i == 0 or lead <= 0.01:
                trimmed.append(srcp)
                continue
            td = work / ("%s_trim_%d.mp4" % (out_mp4.stem, i))
            dur_i = probe_duration(srcp)
            keep = max(dur_i - lead, 0.1)
            cmd_t = ["ffmpeg", "-y", "-ss", "%.3f" % lead, "-i", str(srcp), "-t", "%.3f" % keep,
                     "-an", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
                     "-movflags", "+faststart", str(td)]
            rt = subprocess.run(cmd_t, capture_output=True, text=True, timeout=600)
            if rt.returncode != 0 or not td.is_file() or td.stat().st_size < 1000:
                trimmed.append(srcp)
            else:
                trimmed.append(td)
        listf = work / (out_mp4.stem + "_concat.txt")
        lines = ["file '%s'" % str(Path(pp).resolve()).replace("'", "'\''") for pp in trimmed]
        listf.write_text(chr(10).join(lines) + chr(10), encoding="utf-8")
        cmd2 = ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(listf),
                "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
                "-an", "-movflags", "+faststart", str(out_mp4)]
        r2 = subprocess.run(cmd2, capture_output=True, text=True, timeout=1800)
        listf.unlink(missing_ok=True)
        for td in trimmed:
            if td not in parts:
                td.unlink(missing_ok=True)
        if r2.returncode != 0 or not out_mp4.is_file() or out_mp4.stat().st_size < 1000:
            raise RuntimeError("E_H3_SEGMENT_CONCAT")
    return out_mp4


PROMPT = ("Use <Picture 1> as the only source for the character identity, face, hair, body proportions, clothes, colors and accessories. "
          "Animate that exact character. Motion and pose follow the Fun ControlNet depth/control video (not a reference picture). "
          "Never copy clothes, face, textures or background from the control video. Render the character from <Picture 1>. "
          "Stable outfit throughout, neutral background, fixed camera, no speech.")
ANTI = (" Strict anti-bleed: the outfit, colors and accessories must exactly match <Picture 1> in every frame; "
        "do not invent, add or swap any clothing; ignore clothing silhouette from the depth control except body pose/motion.")

# Official R2V tip: assign each reference a job. Default roles match 峻弘 asset pack:
# 1=shoulder-up, 2=turnaround, 3=full-body detail (extra refs = additional identity).
REF_ROLES = (
    "face, hair and identity (shoulder-up close-up)",
    "body proportions and silhouette (three-view / turnaround)",
    "full-body clothing, colors and accessories",
)
MAX_REFS = 9  # MiniMaxH3ReferenceToVideo ref_images autogrow max


def multi_ref_prompt(n_imgs, anti):
    """One character from N refs; each <Picture i> gets an explicit job (Comfy docs)."""
    n = max(1, min(int(n_imgs), MAX_REFS))
    parts = []
    for i in range(n):
        role = REF_ROLES[i] if i < len(REF_ROLES) else "additional identity and appearance detail"
        parts.append("<Picture %d> provides %s" % (i + 1, role))
    pics = ", ".join("<Picture %d>" % (i + 1) for i in range(n))
    head = (
        "%s. Together they are the SAME single character; render exactly one person. "
        "Use %s only for character identity, face, hair, body proportions, clothes, colors and accessories. "
        % ("; ".join(parts), pics)
    )
    body = (
        "Animate that exact character. Motion and pose follow the Fun ControlNet depth/control video "
        "(not a reference picture). Never copy clothes, face, textures or background from the control video. "
        "Stable outfit throughout, neutral background, fixed camera, no speech."
    )
    pr = head + body
    if anti:
        pr += (
            " Strict anti-bleed: the outfit, colors and accessories must exactly match %s in every frame; "
            "do not invent, add or swap any clothing; ignore clothing silhouette from the depth control "
            "except body pose/motion." % pics
        )
    return pr



def resolve_cn_end(kind):
    """Actual Fun CN end_percent used by graph(): depth default 0.75, else 1.0; H3_CN_END wins."""
    default = 0.75 if str(kind).lower() == 'depth' else 1.0
    return float(os.environ.get('H3_CN_END', str(default)))


def resolve_cn_start():
    return float(os.environ.get('H3_CN_START', '0.0'))


def resolve_cn_strength():
    return float(os.environ.get('H3_CN_STRENGTH', '1.0'))


def graph(img, vid, prefix, W, H, n, kind, anti, seed):
    """Build API graph: character images -> Ref2VA refs; depth -> Fun ControlNet (not ref_video)."""
    imgs = list(img) if isinstance(img, (list, tuple)) else [img]
    imgs = imgs[:MAX_REFS]
    g = json.loads(WORKFLOW.read_text(encoding="utf-8"))
    g["6"]["inputs"]["image"] = imgs[0]
    g["7"]["inputs"]["file"] = vid  # control video for Fun ControlNet only
    if len(imgs) > 1:
        pr = multi_ref_prompt(len(imgs), anti)
    else:
        pr = PROMPT + (ANTI if anti else "")
    g["9"]["inputs"].update(prompt=pr, width=W, height=H, length=n, ref_image_size="max")
    i9 = g["9"]["inputs"]
    for k in list(i9):
        if "ref_video" in k:
            i9.pop(k)
    if "ref_image_0" in i9:
        i9["ref_images.ref_image_0"] = i9.pop("ref_image_0")
    for j, nm in enumerate(imgs[1:], 1):
        nid = "6_%d" % j
        g[nid] = {"class_type": "LoadImage", "inputs": {"image": nm}}
        i9["ref_images.ref_image_%d" % j] = [nid, 0]
    if "20" in g:
        # Depth-only (our default path): community FunControl + RunComfy/T8 Advanced prefer
        # releasing control before late texture steps (~0.6–0.75). Official node default is 1.0;
        # keep that for non-depth. Env H3_CN_END always wins. Shared via resolve_cn_*.
        g["20"]["inputs"]["strength"] = resolve_cn_strength()
        g["20"]["inputs"]["end_percent"] = resolve_cn_end(kind)
        g["20"]["inputs"]["start_percent"] = resolve_cn_start()
        # Optional Model Sparse Attention (official H3 docs, ComfyUI >=0.35): UNET -> sparse -> FunCN.
        # Default OFF until GPU A/B; silent dense fallback needs the node present. Env H3_SPARSE=1.
        # Docs tip: start later (~0.4) and end earlier (~0.9) to keep open/close frames dense.
        if os.environ.get("H3_SPARSE", "0").strip() in ("1", "true", "True", "yes", "on"):
            sparse_id = "21"
            # node_id BlockSparseAttention (UI title: Model Sparse Attention)
            g[sparse_id] = {
                "class_type": "BlockSparseAttention",
                "inputs": {
                    "model": ["2", 0],
                    "selection": os.environ.get("H3_SPARSE_METHOD", "sol-attn"),
                    "tau": float(os.environ.get("H3_SPARSE_TAU", "1.3")),
