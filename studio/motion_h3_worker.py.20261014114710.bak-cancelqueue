def run_one(p, d, idx, total, img_path, ctl, out_dir):
    cid = uuid.uuid4().hex; folder = INPUT_SUB+'/'+d['id']
    base_pct = idx*100.0/total; span = 100.0/total
    def prog(stage, frac, extra=''):
        pct = int(base_pct+span*frac); pct = min(pct, 99)
        label = f'第 {idx+1}/{total} 条' if total > 1 else ''
        setp(p, d, state='running', inference_started=True, stage=stage, progress=pct,
             message=('生成中 '+label+' · '+stage+(' '+extra if extra else '')+f' · {pct}%').replace('  ', ' '))
    prog('准备', 0.01)
    seg_dir = out_dir / ('_segs_' + str(idx))
    try:
        parts, split, src_dur = split_control_video(ctl['path'], seg_dir)
    except Exception:
        raise RuntimeError('E_H3_SEGMENT_SPLIT')
    if split:
        log('job '+d['id']+' split control dur=%.2fs segs=%d seg_sec=%d' % (src_dur, len(parts), segment_sec()))
        prog('准备', 0.02, '长视频切 %d 段' % len(parts))
    seg_slots = []
    nseg = max(len(parts), 1)
    for si, part_path in enumerate(parts):
        seg_ctl = dict(ctl)
        seg_ctl['path'] = Path(part_path)
        frac0 = si / nseg
        frac1 = (si + 1) / nseg
        def prog_seg(stage, frac, extra='', _f0=frac0, _f1=frac1, _si=si):
            local = _f0 + (_f1 - _f0) * frac
            extra2 = (extra + ' · 段%d/%d' % (_si + 1, nseg)) if nseg > 1 else extra
            prog(stage, local, extra2)
        prog_seg('准备', 0.01)
        _ips = list(img_path) if isinstance(img_path, (list, tuple)) else [img_path]
        ci = [upload(ip, 'person%d' % j + Path(ip).suffix.lower(), folder) for j, ip in enumerate(_ips)]
        ci = ci if len(ci) > 1 else ci[0]
        prefix = 'motion_generate_h3/'+d['id']+'/r'+str(idx)+'_s'+str(si)
        vprobe = probe_video(seg_ctl['path'])
        # OOM step-down below native 1MP (official canvas); control re-prepared each attempt
        area_scales = (1.0, 0.55, 0.35)
        last_err = None
        for attempt, ascale in enumerate(area_scales):
            W, H, n = plan(*vprobe, area_scale=ascale)
            prep = seg_dir / ('ctl_prep_%d_a%d.mp4' % (si, attempt))
            prepare_control_video(seg_ctl['path'], prep, W, H, n)
            vi = upload(prep, 'control_s%d_a%d.mp4' % (si, attempt), folder)
            free_vram()
            if attempt:
                prog_seg('准备', 0.02, '显存不足，降到 %dx%d 重试' % (W, H))
                log('job %s seg%d OOM retry attempt=%d -> %dx%d n=%d' % (d['id'], si, attempt, W, H, n))
            cid = uuid.uuid4().hex
            ws = websocket.create_connection(WS+cid, timeout=30)
            try:
                r = requests.post(URL+'/prompt', json={'prompt': graph(ci, vi, prefix, W, H, n, seg_ctl['kind'], d['anti_bleed'], 123456+idx*100+si+attempt*17), 'client_id': cid}, timeout=60)
                if r.status_code != 200:
                    log('prompt rejected '+str(r.status_code)+' '+r.text[:800]); raise RuntimeError('E_H3_PROMPT_REJECTED')
                node_errors = (r.json() or {}).get('node_errors') or {}
                if node_errors:
                    log('prompt node_errors '+json.dumps(node_errors, ensure_ascii=False)[:800]); raise RuntimeError('E_H3_PROMPT_REJECTED')
                pid = r.json()['prompt_id']; prog_seg('加载模型', 0.03)
                stage = '加载模型'; ws.settimeout(20); deadline = time.time()+4*3600; last = 0
                oom = False
                while time.time() < deadline:
                    try: raw = ws.recv()
                    except websocket.WebSocketTimeoutException:
                        if is_cancelled(p):
                            interrupt_comfy(); free_vram()
                            raise RuntimeError('E_H3_CANCELLED')
                        if not gpu_present(): raise RuntimeError('E_H3_GPU_LOST')
                        h = requests.get(URL+'/history/'+pid, timeout=15).json().get(pid)
                        if h and h.get('status', {}).get('completed'): break
                        if h and h.get('status', {}).get('status_str') == 'error':
                            raw_err = json.dumps(h.get('status'), ensure_ascii=False)
                            if 'OutOfMemory' in raw_err or 'out of memory' in raw_err.lower():
                                oom = True; break
                            raise RuntimeError('E_H3_EXECUTION')
                        continue
                    if not isinstance(raw, str): continue
                    msg = json.loads(raw); t = msg.get('type'); data = msg.get('data', {})
                    if data.get('prompt_id') not in (None, pid): continue
                    if t == 'executing':
                        if is_cancelled(p):
                            interrupt_comfy(); free_vram()
                            raise RuntimeError('E_H3_CANCELLED')
                        node = data.get('node')
                        if node is None: break
                        stage = NODE_STEP.get(str(node), stage)
                        frac = {'加载模型': 0.05, '编码参考': 0.08, '采样': 0.10, '解码': 0.90, '保存': 0.97}.get(stage, 0.05)
                        prog_seg(stage, frac)
                    elif t == 'progress' and stage == '采样' and time.time()-last > 2:
                        if is_cancelled(p):
                            interrupt_comfy(); free_vram()
                            raise RuntimeError('E_H3_CANCELLED')
                        v, mx = int(data.get('value', 0)), int(data.get('max', 1)) or 1
                        last = time.time(); prog_seg('采样', 0.10+0.80*v/mx, f'{v}/{mx} 步')
                    elif t == 'execution_error':
                        log('execution_error '+json.dumps({k: data.get(k) for k in ('node_id', 'node_type', 'exception_type', 'exception_message')}, ensure_ascii=False)[:1500])
                        et = str(data.get('exception_type') or '') + str(data.get('exception_message') or '')
                        if 'OutOfMemory' in et or 'out of memory' in et.lower():
                            oom = True; break
                        raise RuntimeError('E_H3_EXECUTION')
                    elif t == 'execution_interrupted': raise RuntimeError('E_H3_INTERRUPTED')
                else:
                    requests.post(URL+'/interrupt', timeout=10); raise RuntimeError('E_H3_TIMEOUT')
                if oom:
                    last_err = 'OOM@%dx%d' % (W, H)
                    try: requests.post(URL+'/interrupt', timeout=5)
                    except Exception: pass
                    free_vram()
                    continue
                h = requests.get(URL+'/history/'+pid, timeout=15).json()[pid]
                if h.get('status', {}).get('status_str') == 'error':
                    raw_err = json.dumps(h.get('status'), ensure_ascii=False)
                    if 'OutOfMemory' in raw_err or 'out of memory' in raw_err.lower():
                        last_err = 'OOM@%dx%d' % (W, H); free_vram(); continue
                    raise RuntimeError('E_H3_EXECUTION')
                o = h['outputs']['18']; files = o.get('images', [])+o.get('videos', [])+o.get('gifs', [])
                f = next((x for x in files if x['filename'].endswith('.mp4')), None)
                if not f: raise RuntimeError('E_H3_NO_OUTPUT')
                src = (R/'outputs'/f.get('subfolder', '')/f['filename']).resolve()
                if not src.is_relative_to((R/'outputs'/'motion_generate_h3').resolve()): raise RuntimeError('E_H3_OUTPUT_PATH')
                seg_slot = out_dir / ('result-%d-seg%d.mp4' % (idx, si))
                shutil.move(str(src), str(seg_slot))
                seg_slots.append(seg_slot)
                if attempt:
                    log('job %s seg%d recovered after OOM at %dx%d' % (d['id'], si, W, H))
                break
            finally:
                try: ws.close()
                except Exception: pass
        else:
            raise RuntimeError('E_H3_OOM')
        # new client id per segment to avoid ws reuse issues
        cid = uuid.uuid4().hex
    shutil.rmtree(R/'inputs'/INPUT_SUB/d['id'], ignore_errors=True)
    slot = 'result-'+str(idx)+'.mp4'
    final = out_dir / slot
    if len(seg_slots) == 1:
        seg_slots[0].replace(final)
    else:
        prog('保存', 0.98, '拼接 %d 段' % len(seg_slots))
        concat_mp4s(seg_slots, final)
        for s in seg_slots:
            s.unlink(missing_ok=True)
    # Model forces >=~5.17s; short drivers (and slid long-tail windows) can overshoot.
    # Trim delivery toward the control/source duration so "跟原片一样长" stays honest.
    try:
        got = probe_duration(final)
        if src_dur > 0.2 and got > src_dur + 0.12:
            tmp = out_dir / (final.stem + '_trim.mp4')
            trim_to_duration(final, tmp, src_dur)
            final.unlink(missing_ok=True)
            tmp.replace(final)
            log('job %s trim delivery %.3fs -> %.3fs' % (d['id'], got, src_dur))
    except Exception as te:
        log('trim skip '+str(te)[:160])
    shutil.rmtree(seg_dir, ignore_errors=True)
    return slot


def process(p):
    d = json.loads(p.read_text(encoding='utf-8'))
    if d.get('state') not in ('queued', 'running'): return False
    try:
        controls = m.resolve_controls(d['owner'], d['motion_ids']); c = m.catalog()
        # Prefer depth controls only when any depth is selected (skip white/灰模).
        _depths = [x for x in controls if x.get('kind') == 'depth']
        if _depths:
            controls = _depths  # DEPTH_PREFERRED
        images = [x['path'] for x in m.resolve_images(d['owner'], d['image_ids'])]
        if len(images) != len(d['image_ids']) or not controls: raise RuntimeError('E_H3_INPUT_MISSING')
        out = OUT_ROOT/d['id']; out.mkdir(parents=True, exist_ok=True, mode=0o700)
        if d.get('per_image'): pairs = [(im, ct) for im in images for ct in controls]
        else: pairs = [(images[:MAX_REFS], ct) for ct in controls]  # MULTIREF: one character -> one video per motion
        slots = []
        for i, (im, ct) in enumerate(pairs):
            if is_cancelled(p): raise RuntimeError('E_H3_CANCELLED')
            free_vram()  # sequential slots + free VRAM between
            slots.append(run_one(p, d, i, len(pairs), im, ct, out))
            free_vram()
        shutil.rmtree(R/'outputs'/'motion_generate_h3'/d['id'], ignore_errors=True)
        # Prefer original driver audio on primary slots; keep H3 AI audio as secondary *-aiaudio.mp4.
        # Never feed original RGB frames into H3 — audio mux only after save.
        driver = driver_video_path(d['owner'], d.get('motion_ids') or [])
        final_slots = []
        ai_slots = []
        mux_ok = 0
        if driver is not None and has_audio(driver):
            for slot in slots:
                ai_name = slot.replace('.mp4', '-aiaudio.mp4')
                ai_path = out / ai_name
                primary = out / slot
                try:
                    primary.replace(ai_path)  # move AI aside
                    mux_orig_audio(ai_path, driver, primary)
                    final_slots.append(slot)
                    ai_slots.append(ai_name)
                    mux_ok += 1
                except Exception as me:
                    log('mux skip '+slot+' '+str(me)[:200])
                    # restore AI as primary if mux failed
                    if ai_path.is_file() and not primary.is_file():
                        ai_path.replace(primary)
                    final_slots.append(slot)
        else:
            final_slots = list(slots)
            if driver is None:
                log('mux skip: no driver video')
            else:
                log('mux skip: driver has no audio')
        # Upscale native ~1MP results to Douyin delivery ~1080x1920 (ffmpeg lanczos)
        delivery_slots = []
        native_slots = []
        for slot in final_slots:
            primary = out / slot
            native_name = slot.replace('.mp4', '-native.mp4')
            delivery = out / slot
            native_path = out / native_name
            try:
                if primary.is_file():
                    primary.replace(native_path)
                    upscale_to_delivery(native_path, delivery, DELIVERY_W, DELIVERY_H)
                    # restore audio onto upscaled if mux put audio on native
                    if has_audio(native_path) and not has_audio(delivery):
                        tmpu = out / (slot + '.aud.mp4')
                        cmd = ['ffmpeg', '-y', '-i', str(delivery), '-i', str(native_path),
                               '-map', '0:v:0', '-map', '1:a:0', '-c:v', 'copy', '-c:a', 'copy',
                               '-shortest', '-movflags', '+faststart', str(tmpu)]
                        rr = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
                        if rr.returncode == 0 and tmpu.is_file():
                            delivery.unlink(missing_ok=True); tmpu.replace(delivery)
                    delivery_slots.append(slot)
                    native_slots.append(native_name)
                    # record dims without reading pixels
                    try:
                        dw, dh, df, _ = probe_video(delivery)
                        nw, nh, nf, _ = probe_video(native_path)
                        d.setdefault('render_meta', {})
                        n_refs = 1 if d.get('per_image') else min(len(images), MAX_REFS)
                        default_steps = 25 if n_refs > 1 else 20
                        # slot is result-{idx}.mp4 — mirror the control kind graph() actually used
                        _kind = 'depth'
                        try:
                            _si = int(str(slot).split('result-', 1)[1].split('.', 1)[0])
                            if 0 <= _si < len(pairs):
                                _kind = (pairs[_si][1] or {}).get('kind') or _kind
                        except (IndexError, ValueError, TypeError):
                            pass
                        d['render_meta'][slot] = {
                            'native_wh': [nw, nh], 'delivery_wh': [dw, dh],
                            'native_frames': nf, 'delivery_frames': df,
                            'fps': 24, 'engine': 'minimax_h3_ref2va+fun_controlnet',
                            'control': 'MiniMaxH3FunControlNetApply',
                            'control_kind': _kind,
                            'upscale': 'ffmpeg_lanczos',
                            'cn_strength': resolve_cn_strength(),
                            'cn_start': resolve_cn_start(),
                            # must match graph() end_percent (depth→0.75, else→1.0; H3_CN_END wins)
                            'cn_end': resolve_cn_end(_kind),
                            'steps': int(os.environ.get('H3_STEPS', str(default_steps))),
                            'scheduler': os.environ.get('H3_SCHEDULER', 'simple'),
                            'n_refs': n_refs,
                            'sparse': os.environ.get('H3_SPARSE', '0').strip() in ('1', 'true', 'True', 'yes', 'on'),
                        }
                    except Exception:
                        pass
            except Exception as ue:
                log('upscale skip '+slot+' '+str(ue)[:200])
                if native_path.is_file() and not primary.is_file():
                    native_path.replace(primary)
                delivery_slots.append(slot)
        if not delivery_slots:
            delivery_slots = list(final_slots)
        all_slots = delivery_slots + native_slots + ai_slots
        urls = ['/api/motion-preview/generation-jobs/'+d['id']+'/results/'+s for s in all_slots]
        msg = f'出片完成 · 共 {len(delivery_slots)} 条'
        if mux_ok:
            msg += f' · 已贴原声 {mux_ok} 条'
        msg += ' · 已升到约%dx%d' % (DELIVERY_W, DELIVERY_H)
        msg += ' · 100%'
        setp(p, d, state='done', stage='完成', progress=100, message=msg, results=urls, output_slots=all_slots,
             render_meta=d.get('render_meta'))
        log('job '+d['id']+' done slots='+str(len(delivery_slots))+' mux='+str(mux_ok)+' upscale=lanczos')
    except Exception as e:
        if str(e) in ('E_H3_CANCELLED', 'E_H3_INTERRUPTED') and is_cancelled(p):
            log('job '+d['id']+' cancelled by user')
            interrupt_comfy()
            free_vram()
            shutil.rmtree(R/'outputs'/'motion_generate_h3'/d['id'], ignore_errors=True)
            shutil.rmtree(R/'inputs'/INPUT_SUB/d['id'], ignore_errors=True)
            shutil.rmtree(OUT_ROOT/d['id'], ignore_errors=True)
            p.unlink(missing_ok=True)
            return True
        code = str(e) if str(e).startswith('E_H3_') else 'E_H3_'+type(e).__name__.upper()
        log('job '+d['id']+' failed '+code+'\n'+traceback.format_exc()[-1500:])
        msg = '显存不够，已自动降分辨率仍失败（错误码 E_H3_OOM），可缩短视频或降低画质后重试' if code=='E_H3_OOM' else '出片失败（错误码 '+code+'），可重新提交'
        setp(p, d, state='failed', stage='失败', message=msg)
    return True

def tick():
    a = Adapter(); pr = a.probe()
    for p in sorted(m.GENERATE.glob('*.json')):
        if not ID.fullmatch(p.stem): continue
        try: d = json.loads(p.read_text(encoding='utf-8'))
        except (OSError, ValueError): continue
        st = d.get('state')
        if st == 'running':  # crashed mid-run -> retry once from queued
            if d.get('_retried'): setp(p, d, state='failed', message='出片中断（错误码 E_H3_WORKER_RESTART），可重新提交'); continue
            setp(p, d, state='queued', _retried=True, message='上次中断，重新排队'); st = 'queued'
        if st == 'engine_pending':
            if not pr['gpu']: setp(p, d, message='已排队：需要带卡开机（H3 模型已就绪）' if pr['ready'] else '已排队：H3 模型未齐'); continue
            if not pr['ready']: setp(p, d, message='已排队：H3 模型校验未通过'); continue
            if not pr['idle']: setp(p, d, message='已排队：显卡正忙，等待空闲'); continue
            bridge.dispatch_one(a, p.stem)
            d = json.loads(p.read_text(encoding='utf-8')); st = d.get('state')
        if st == 'queued' and pr['gpu'] and pr['idle']:
            process(p); return

def main():
