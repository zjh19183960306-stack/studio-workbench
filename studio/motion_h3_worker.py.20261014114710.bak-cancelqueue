def align_frame_count(n):
    """Snap to official 17k+5 grid inside the 5–15s window (124–345 @24fps)."""
    n = int(n)
    min_f = int(os.environ.get("H3_MIN_FRAMES", str(H3_MIN_FRAMES)))
    max_f = int(os.environ.get("H3_MAX_FRAMES", str(H3_MAX_FRAMES)))
    if min_f % 17 != 5:
        min_f = H3_MIN_FRAMES
    if max_f % 17 != 5 or max_f < min_f:
        max_f = H3_MAX_FRAMES
    if n <= min_f:
        return min_f
    if n >= max_f:
        return max_f
    c = n
    while c % 17 != 5:
        c += 1
    if c <= max_f:
        return c
    f = n
    while f % 17 != 5 and f > min_f:
        f -= 1
    return max_f if f % 17 != 5 else f


def align_frame_count_ceil(n):
    """Compat alias: same as align_frame_count (ceil-inside-window)."""
    return align_frame_count(n)


def prepare_control_video(src, dest, W, H, n_frames):
    """Resample control to 24fps, scale to WxH, exact n_frames (17k+5). Required by Fun ControlNet.
    Short drivers are last-frame-padded enough to reach n_frames (official: shorter control holds last frame).
    """
    src, dest = Path(src), Path(dest)
    dest.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Generous clone pad so -frames:v can always reach n_frames even for ~1s drivers.
    pad_sec = max(16.0, float(n_frames) / float(H3_FPS) + 1.0)
    vf = ("fps=24,scale=%d:%d:force_original_aspect_ratio=decrease,"
          "pad=%d:%d:(ow-iw)/2:(oh-ih)/2:color=black,setsar=1,"
          "tpad=stop_mode=clone:stop_duration=%.3f") % (W, H, W, H, pad_sec)
    cmd = ["ffmpeg", "-y", "-i", str(src), "-an", "-vf", vf,
           "-frames:v", str(n_frames), "-c:v", "libx264", "-pix_fmt", "yuv420p",
           "-preset", "veryfast", "-crf", "18", "-movflags", "+faststart", str(dest)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    if r.returncode != 0 or not dest.is_file() or dest.stat().st_size < 1000:
        raise RuntimeError("E_H3_CONTROL_PREP")
    pw, ph, pf, pfp = probe_video(dest)
    if abs(pw - W) > 1 or abs(ph - H) > 1:
        raise RuntimeError("E_H3_CONTROL_PREP")
    return dest

def upscale_to_delivery(src, dest, target_w=1080, target_h=1920):
    """Post-gen Douyin delivery upscale via ffmpeg lanczos (no local VSR model installed).
    Official: gen at native ~1MP then upscale separately.
    """
    src, dest = Path(src), Path(dest)
    vf = ("scale=%d:%d:force_original_aspect_ratio=decrease:flags=lanczos,"
          "pad=%d:%d:(ow-iw)/2:(oh-ih)/2:color=black,setsar=1") % (target_w, target_h, target_w, target_h)
    cmd = ["ffmpeg", "-y", "-i", str(src), "-vf", vf, "-c:v", "libx264", "-pix_fmt", "yuv420p",
           "-preset", "medium", "-crf", "16", "-c:a", "copy", "-movflags", "+faststart", str(dest)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
    if r.returncode != 0 or not dest.is_file() or dest.stat().st_size < 1000:
        cmd = ["ffmpeg", "-y", "-i", str(src), "-vf", vf, "-c:v", "libx264", "-pix_fmt", "yuv420p",
               "-preset", "medium", "-crf", "16", "-an", "-movflags", "+faststart", str(dest)]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
        if r.returncode != 0 or not dest.is_file() or dest.stat().st_size < 1000:
            raise RuntimeError("E_H3_UPSCALE")
    try:
        os.chmod(dest, 0o600)
    except OSError:
        pass
    return dest

