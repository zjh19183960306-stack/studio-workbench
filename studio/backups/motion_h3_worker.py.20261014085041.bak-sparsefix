def weights_ok():
    try:
        v = json.loads((R/'char_anim_h3'/'verified.json').read_text())
        need = ('vv','av','te','ref')
        if not all(k in v and Path(v[k]['path']).is_file() and Path(v[k]['path']).stat().st_size == v[k]['size'] for k in need):
            return False
        # Fun ControlNet Union patch required for depth-driven H3
        cn = v.get('cn') or {}
        cn_path = Path(cn.get('path') or (R/'ComfyUI'/'models'/'model_patches'/'minimax_h3_fun_controlnet_union_pruned_int8_convrot.safetensors'))
        if cn.get('size'):
            return cn_path.is_file() and cn_path.stat().st_size == cn['size']
        return cn_path.is_file() and cn_path.stat().st_size > 1_000_000_000
    except (OSError, ValueError, KeyError): return False

def comfy_stats():
    try: return requests.get(URL+'/system_stats', timeout=5).json()
    except (requests.RequestException, ValueError): return None

def comfy_idle():
    try:
        q = requests.get(URL+'/queue', timeout=5).json()
        return not q.get('queue_running') and not q.get('queue_pending')
    except (requests.RequestException, ValueError): return False

class Adapter:
    """Local-only adapter for motion_h3_bridge.dispatch_one."""
    def probe(self):
        s = comfy_stats(); cuda = bool(s and any(d.get('type') == 'cuda' for d in s.get('devices', [])))
        return {'gpu': gpu_present() and cuda, 'ready': weights_ok(), 'idle': cuda and comfy_idle(),
                'control_video_input': True, 'engine': 'minimax_h3_ref2va_local'}
    def enqueue(self, manifest):
        # Durable + idempotent: the queue json itself is the record (keyed by id).
        return {'accepted': manifest.get('engine') == 'minimax_h3_ref2va_local'
                and manifest.get('appearance_source') == 'images_only'
                and manifest.get('motion_source') == 'approved_controls_only'}

def is_cancelled(p):
    try: return json.loads(p.read_text(encoding='utf-8')).get('state') == 'cancelled'
    except (OSError, ValueError): return True  # record removed = cancelled

def setp(p, d, **kw):
    if is_cancelled(p) and kw.get('state') != 'cancelled': raise RuntimeError('E_H3_CANCELLED')
    d.update(updated_at=time.time(), steps=STEPS, **kw); atomic(p, d)

def upload(path, name, folder):
    with open(path, 'rb') as f:
        r = requests.post(URL+'/upload/image', files={'image': (name, f, 'application/octet-stream')},
                          data={'type': 'input', 'subfolder': folder, 'overwrite': 'true'}, timeout=600)
    r.raise_for_status(); d = r.json(); return d['subfolder']+'/'+d['name']

def probe_video(path):
    r = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'v:0', '-count_packets',
                        '-show_entries', 'stream=width,height,nb_read_packets,r_frame_rate', '-of', 'json', str(path)],
                       capture_output=True, text=True, timeout=120)
    s = json.loads(r.stdout)['streams'][0]
    num, den = (s.get('r_frame_rate') or '24/1').split('/'); fps = float(num)/float(den or 1)
    return int(s['width']), int(s['height']), int(s['nb_read_packets']), fps

def plan(w, h, frames, fps, area_scale=1.0):
    """Native H3 canvas (~1MP): 768 short-edge, area cap 768*1344, axes multiple of 32.
    Official docs: generate at native, upscale separately for Douyin 1080x1920.
    Frame count: ceil to 17k+5 at 24fps (matches align_frame_count).
    area_scale < 1.0 only for OOM step-down below native.
    """
    import math
    secs = frames / max(fps, 1e-6)
    n = int(round(max(secs, 0.0) * 24))
    n = max(5, n)
    while n % 17 != 5:  # ceil to 17k+5 (official align_frame_count)
        n += 1
    base = float(os.environ.get("H3_BASE_SHORT", "768"))
    max_pixels = float(os.environ.get("H3_MAX_PIXELS", str(768 * 1344)))
    ratio = (w / max(h, 1e-6)) if w and h else 9 / 16
    if ratio >= 1.0:
        nom_w, nom_h = base * ratio, base
    else:
        nom_w, nom_h = base, base / ratio
    if nom_w * nom_h > max_pixels:
        s = math.sqrt(max_pixels / (nom_w * nom_h))
        nom_w, nom_h = nom_w * s, nom_h * s
    if area_scale < 1.0:
        s2 = math.sqrt(max(0.15, float(area_scale)))
        nom_w, nom_h = nom_w * s2, nom_h * s2
    W = max(256, int(round(nom_w / 32) * 32))
    H = max(256, int(round(nom_h / 32) * 32))
    return W, H, n

def free_vram():
    """Unload Comfy models + free CUDA cache between slots/segments (memory-safe)."""
    try:
        requests.post(URL+'/free', json={'unload_models': True, 'free_memory': True}, timeout=60)
    except Exception as e:
        log('free_vram warn '+str(e)[:120])
    try:
        requests.post(URL+'/interrupt', timeout=5)
    except Exception:
        pass


def has_audio(path):
    r = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'a:0',
                        '-show_entries', 'stream=codec_type', '-of', 'csv=p=0', str(path)],
                       capture_output=True, text=True, timeout=120)
    return r.returncode == 0 and 'audio' in (r.stdout or '')

def probe_duration(path):
    r = subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration',
                        '-of', 'json', str(path)], capture_output=True, text=True, timeout=120)
    if r.returncode != 0:
        raise RuntimeError('E_H3_PROBE')
    return float(json.loads(r.stdout)['format']['duration'])

def driver_video_path(owner, motion_ids):
    """Resolve original driver RGB video from motion preview video_id. Never use depth/white."""
    if not motion_ids:
        return None
    mid = motion_ids[0]
    if not isinstance(mid, str) or ':' not in mid:
        return None
    jid = mid.split(':', 1)[0]
    try:
        d = m.read_owned(m.QUEUE, jid, owner)
    except ValueError:
        return None
    vid = d.get('video_id')
    if not isinstance(vid, str):
        return None
    c = m.catalog()
    v = c.get(vid)
    if not v or v.get('kind') != 'video':
        return None
    p = Path(v['path'])
    if not p.is_file() or p.is_symlink():
        return None
    return p

def mux_orig_audio(result_mp4, driver_mp4, out_mp4):
    """Keep result video frames; replace audio with driver. Trim/pad to result duration."""
    result_mp4, driver_mp4, out_mp4 = Path(result_mp4), Path(driver_mp4), Path(out_mp4)
    if out_mp4.exists():
        out_mp4.unlink()
    if not has_audio(driver_mp4):
        raise RuntimeError('E_H3_NO_DRIVER_AUDIO')
    dur = probe_duration(result_mp4)
    cmd = ['ffmpeg', '-y', '-i', str(result_mp4), '-i', str(driver_mp4),
           '-map', '0:v:0', '-map', '1:a:0', '-c:v', 'copy', '-af', 'apad',
           '-t', f'{dur:.6f}', '-c:a', 'aac', '-b:a', '192k',
           '-movflags', '+faststart', str(out_mp4)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
    if r.returncode != 0 or not out_mp4.is_file() or out_mp4.stat().st_size < 1000:
        raise RuntimeError('E_H3_MUX_FAIL')
    try:
        os.chmod(out_mp4, 0o600)
    except OSError:
        pass
    return out_mp4


def segment_sec():
    try:
        return max(5, min(15, int(os.environ.get('H3_SEGMENT_SEC', '15'))))
    except ValueError:
        return 15

def split_control_video(src, work_dir, seg_sec=None):
    """If duration > seg_sec, cut into <=seg_sec clips with 1s overlap (for xfade). Else [src]."""
    seg_sec = segment_sec() if seg_sec is None else seg_sec
    overlap = float(os.environ.get("H3_SEGMENT_OVERLAP", "1.0"))
    src = Path(src)
    dur = probe_duration(src)
    if dur <= seg_sec + 0.05:
        return [src], False, dur
    work_dir = Path(work_dir)
    work_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
    parts = []
    t = 0.0
    i = 0
    step = max(seg_sec - overlap, 1.0)
    while t < dur - 0.05:
        part = work_dir / ("ctl_seg_%03d.mp4" % i)
        length = min(seg_sec, max(dur - t, 0.1))
        cmd = ["ffmpeg", "-y", "-ss", "%.3f" % t, "-i", str(src), "-t", "%.3f" % length,
               "-an", "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
               "-movflags", "+faststart", str(part)]
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
        if r.returncode != 0 or not part.is_file() or part.stat().st_size < 1000:
            raise RuntimeError("E_H3_SEGMENT_SPLIT")
        parts.append(part)
        t += step
        i += 1
        if i > 500:
            raise RuntimeError("E_H3_SEGMENT_SPLIT")
    return parts, True, dur


def concat_mp4s(parts, out_mp4):
    """Concat segment mp4s; short xfade (0.5s) when >=2 parts, else copy."""
    out_mp4 = Path(out_mp4)
    parts = [Path(p) for p in parts]
    if len(parts) == 1:
        shutil.copy2(parts[0], out_mp4)
        return out_mp4
    xfade = float(os.environ.get("H3_XFADE_SEC", "0.5"))
    n = len(parts)
    cmd = ["ffmpeg", "-y"]
    for p in parts:
        cmd += ["-i", str(p)]
    durs = [probe_duration(p) for p in parts]
    filters = []
    last = "[0:v]"
    offset = 0.0
    for i in range(1, n):
        offset += max(durs[i - 1] - xfade, 0.01)
        outlab = "[v%x]" % i if i < n - 1 else "[vout]"
        filters.append("%s[%d:v]xfade=transition=fade:duration=%.3f:offset=%.3f%s" % (last, i, xfade, offset, outlab))
        last = outlab
    filt = ";".join(filters)
    cmd += ["-filter_complex", filt, "-map", "[vout]",
            "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
            "-an", "-movflags", "+faststart", str(out_mp4)]
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
    if r.returncode != 0 or not out_mp4.is_file() or out_mp4.stat().st_size < 1000:
        work = out_mp4.parent
        listf = work / (out_mp4.stem + "_concat.txt")
        lines = ["file '%s'" % str(Path(p).resolve()).replace("'", "'\''") for p in parts]
        listf.write_text(chr(10).join(lines) + chr(10), encoding="utf-8")
        cmd2 = ["ffmpeg", "-y", "-f", "concat", "-safe", "0", "-i", str(listf),
                "-c:v", "libx264", "-pix_fmt", "yuv420p", "-preset", "veryfast", "-crf", "18",
                "-an", "-movflags", "+faststart", str(out_mp4)]
        r2 = subprocess.run(cmd2, capture_output=True, text=True, timeout=1800)
        listf.unlink(missing_ok=True)
        if r2.returncode != 0 or not out_mp4.is_file() or out_mp4.stat().st_size < 1000:
            raise RuntimeError("E_H3_SEGMENT_CONCAT")
    return out_mp4



PROMPT = ("Use <Picture 1> as the only source for the character identity, face, hair, body proportions, clothes, colors and accessories. "
          "Animate that exact character. Motion and pose follow the Fun ControlNet depth/control video (not a reference picture). "
          "Never copy clothes, face, textures or background from the control video. Render the character from <Picture 1>. "
          "Stable outfit throughout, neutral background, fixed camera, no speech.")
ANTI = (" Strict anti-bleed: the outfit, colors and accessories must exactly match <Picture 1> in every frame; "
        "do not invent, add or swap any clothing; ignore clothing silhouette from the depth control except body pose/motion.")

# Official R2V tip: assign each reference a job. Default roles match 峻弘 asset pack:
# 1=shoulder-up, 2=turnaround, 3=full-body detail (extra refs = additional identity).
REF_ROLES = (
    "face, hair and identity (shoulder-up close-up)",
    "body proportions and silhouette (three-view / turnaround)",
    "full-body clothing, colors and accessories",
)
MAX_REFS = 9  # MiniMaxH3ReferenceToVideo ref_images autogrow max


def multi_ref_prompt(n_imgs, anti):
    """One character from N refs; each <Picture i> gets an explicit job (Comfy docs)."""
    n = max(1, min(int(n_imgs), MAX_REFS))
    parts = []
    for i in range(n):
        role = REF_ROLES[i] if i < len(REF_ROLES) else "additional identity and appearance detail"
        parts.append("<Picture %d> provides %s" % (i + 1, role))
    pics = ", ".join("<Picture %d>" % (i + 1) for i in range(n))
    head = (
        "%s. Together they are the SAME single character; render exactly one person. "
        "Use %s only for character identity, face, hair, body proportions, clothes, colors and accessories. "
        % ("; ".join(parts), pics)
    )
    body = (
        "Animate that exact character. Motion and pose follow the Fun ControlNet depth/control video "
        "(not a reference picture). Never copy clothes, face, textures or background from the control video. "
        "Stable outfit throughout, neutral background, fixed camera, no speech."
    )
    pr = head + body
    if anti:
        pr += (
            " Strict anti-bleed: the outfit, colors and accessories must exactly match %s in every frame; "
            "do not invent, add or swap any clothing; ignore clothing silhouette from the depth control "
            "except body pose/motion." % pics
        )
    return pr


def graph(img, vid, prefix, W, H, n, kind, anti, seed):
    """Build API graph: character images -> Ref2VA refs; depth -> Fun ControlNet (not ref_video)."""
    imgs = list(img) if isinstance(img, (list, tuple)) else [img]
    imgs = imgs[:MAX_REFS]
    g = json.loads(WORKFLOW.read_text(encoding="utf-8"))
    g["6"]["inputs"]["image"] = imgs[0]
    g["7"]["inputs"]["file"] = vid  # control video for Fun ControlNet only
    if len(imgs) > 1:
        pr = multi_ref_prompt(len(imgs), anti)
    else:
        pr = PROMPT + (ANTI if anti else "")
    g["9"]["inputs"].update(prompt=pr, width=W, height=H, length=n, ref_image_size="max")
    i9 = g["9"]["inputs"]
    for k in list(i9):
        if "ref_video" in k:
            i9.pop(k)
    if "ref_image_0" in i9:
        i9["ref_images.ref_image_0"] = i9.pop("ref_image_0")
    for j, nm in enumerate(imgs[1:], 1):
        nid = "6_%d" % j
        g[nid] = {"class_type": "LoadImage", "inputs": {"image": nm}}
        i9["ref_images.ref_image_%d" % j] = [nid, 0]
    if "20" in g:
        g["20"]["inputs"]["strength"] = float(os.environ.get("H3_CN_STRENGTH", "1.0"))
        g["20"]["inputs"]["end_percent"] = float(os.environ.get("H3_CN_END", "1.0"))
        g["20"]["inputs"]["start_percent"] = 0.0
    if "13" in g:
        # Official baseline: res_multistep + simple @ 20. Multi-ref identity lock: 25
        # (docs: raise to 25 when reference still drifts). Override with H3_STEPS.
        g["13"]["inputs"]["scheduler"] = os.environ.get("H3_SCHEDULER", "simple")
        default_steps = "25" if len(imgs) > 1 else "20"
        g["13"]["inputs"]["steps"] = int(os.environ.get("H3_STEPS", default_steps))
    g["10"]["inputs"]["noise_seed"] = seed
    g["18"]["inputs"]["filename_prefix"] = prefix
    return g


NODE_STEP = {'2': '加载模型', '3': '加载模型', '4': '加载模型', '5': '加载模型', '19': '加载模型', '20': '加载模型', '9': '编码参考',
